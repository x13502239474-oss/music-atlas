{
  "_note": "术语表。正文中 [[term]] 语法会被解析为虚线下划线术语卡。short 控制在 120 字以内，只解释「是什么」，延伸阅读交给 link。",
  "terms": [
    {
      "id": "ethos",
      "zh": "ethos（音乐气质说）",
      "latin": "ethos",
      "short": "古希腊观念：不同调式会塑造听者不同的性格与行为倾向。它把音乐当作教化工具，而非纯粹娱乐。",
      "link": "m1-04"
    },
    {
      "id": "tetrachord",
      "zh": "四音列",
      "latin": "tetrachord",
      "short": "古希腊音乐的基本音高单位：四个音，两端为固定音，中间两音可移动，由此产生三种「 genera」——自然、变化、半音。",
      "link": "m1-05"
    },
    {
      "id": "harmonia",
      "zh": "harmonia",
      "latin": "harmonia",
      "short": "古希腊语原意为「连接、调合」。在音乐中指一组音的组织方式，后来才演变为现代意义的「和声」。",
      "link": "m1-05"
    },
    {
      "id": "mousike",
      "zh": "mousikē",
      "latin": "mousikē",
      "short": "古希腊的「音乐」远大于今天的概念：诗、歌、舞、器乐合一，且与天文、算术同属「缪斯之术」。",
      "link": "m1-04"
    },
    {
      "id": "aulos",
      "zh": "阿夫洛斯管",
      "latin": "aulos",
      "short": "古希腊双管簧乐器，音色尖锐有穿透力，常用于祭仪、悲剧与体育竞技，与代表理性的里拉形成对照。",
      "link": "m1-07"
    },
    {
      "id": "lyre",
      "zh": "里拉琴",
      "latin": "lyra",
      "short": "古希腊拨弦乐器，音色清亮，与阿波罗崇拜及诗乐教育关联，是「文雅音乐」的象征。",
      "link": "m1-07"
    },
    {
      "id": "neume",
      "zh": "纽姆谱",
      "latin": "neume",
      "short": "中世纪早期记谱符号，形状提示旋律的升降走向，但不标绝对音高，主要作为记忆辅助。",
      "link": "m1-11"
    },
    {
      "id": "plainchant",
      "zh": "圣咏",
      "latin": "plainchant / cantus planus",
      "short": "单声部、无固定节拍的天主教仪式歌曲，以拉丁文演唱，旋律服从经文的重音与句读。",
      "link": "m1-09"
    },
    {
      "id": "gregorian",
      "zh": "格里高利圣咏",
      "latin": "cantus gregorianus",
      "short": "罗马礼仪所用的圣咏总称，传统归于教皇格里高利一世；现存最早完整文献实际晚至 9—10 世纪。",
      "link": "m1-09"
    },
    {
      "id": "mode-chant",
      "zh": "教会调式",
      "latin": "church modes",
      "short": "中世纪理论家从圣咏中归纳出的八种调式，以结束音（final）与音域（ambitus）区分，不是现代大小调。",
      "link": "m1-09"
    },
    {
      "id": "office",
      "zh": "日课",
      "latin": "Divine Office",
      "short": "修道院每日八个时辰的祈祷仪式，以诵经、应答圣咏与赞美诗构成，是圣咏最主要的日常使用场景。",
      "link": "m1-08"
    },
    {
      "id": "mass-ordinary",
      "zh": "常规弥撒",
      "latin": "Ordinary of the Mass",
      "short": "弥撒中文本固定不变的部分：慈悲经、荣耀经、信经、圣哉经、羔羊经。作曲家多以它为单位创作套曲。",
      "link": "m1-09"
    },
    {
      "id": "mass-proper",
      "zh": "专用弥撒",
      "latin": "Proper of the Mass",
      "short": "随教会年历变化的部分：进堂咏、升阶经、哈利路亚、奉献经、领圣体经等，文本随节日更换。",
      "link": "m1-09"
    },
    {
      "id": "organum",
      "zh": "奥尔加农",
      "latin": "organum",
      "short": "最早的复调形式：在圣咏旋律上叠加一个或多个声部，从平行四、五度逐步发展为反向进行与独立节奏。",
      "link": "m1-13"
    },
    {
      "id": "cantus-firmus",
      "zh": "固定旋律",
      "latin": "cantus firmus",
      "short": "被拉长置入低声部、作为全曲结构骨架的既有旋律（多为圣咏），上方声部围绕它构筑复调。",
      "link": "m1-17"
    },
    {
      "id": "isorhythm",
      "zh": "等节奏",
      "latin": "isorhythmia",
      "short": "14 世纪技法：以固定的节奏型（talea）与音高型（color）反复错位组合，使音乐获得严密的结构层次。",
      "link": "m1-14"
    },
    {
      "id": "parody-mass",
      "zh": "模仿弥撒",
      "latin": "parody mass / imitation mass",
      "short": "文艺复兴时期以一首既有作品（常为经文歌或尚松）的动机材料贯穿整部弥撒五个乐章，使套曲获得统一性。",
      "link": "m1-17"
    },
    {
      "id": "imitation",
      "zh": "模仿",
      "latin": "imitation",
      "short": "各声部依次接唱同一动机的织体手法，是文艺复兴复调的核心技术，也是赋格的直接前身。",
      "link": "m1-17"
    },
    {
      "id": "motet",
      "zh": "经文歌",
      "latin": "motet",
      "short": "中世纪至文艺复兴最重要的复调宗教体裁。13 世纪常在各声部叠加不同歌词，16 世纪趋于统一文本与清晰对位。",
      "link": "m1-13"
    },
    {
      "id": "madrigal",
      "zh": "牧歌",
      "latin": "madrigal",
      "short": "16 世纪意大利世俗复调歌曲，以精细的音乐手法（字画法、半音化）表现诗歌的情感与意象。",
      "link": "m1-18"
    },
    {
      "id": "basso-continuo",
      "zh": "通奏低音",
      "latin": "basso continuo",
      "short": "巴洛克核心手法：低音声部加数字标记指示和弦，由键盘与低音乐器即兴实现，使「和声」第一次成为可独立书写的维度。",
      "link": "m1-22"
    },
    {
      "id": "seconda-pratica",
      "zh": "第二实践",
      "latin": "seconda pratica",
      "short": "蒙特威尔第等人主张：为表达歌词情感，可以突破传统对位规则。与「第一实践」（严格对位）相对。",
      "link": "m1-22"
    },
    {
      "id": "recitative",
      "zh": "宣叙调",
      "latin": "recitative",
      "short": "模仿说话节奏与语调的歌唱，承担叙事与对白推进，音乐服从语言。歌剧的基本构成之一。",
      "link": "m1-23"
    },
    {
      "id": "aria",
      "zh": "咏叹调",
      "latin": "aria",
      "short": "结构完整、旋律独立的抒情唱段，让人物停下来表达情感。17 世纪后成为歌剧中最受观众欢迎的部分。",
      "link": "m1-23"
    },
    {
      "id": "camerata",
      "zh": "卡梅拉塔",
      "latin": "Camerata",
      "short": "16 世纪末佛罗伦萨的文人—音乐家圈子，试图复原古希腊戏剧的「歌唱式朗诵」，歌剧由此诞生。",
      "link": "m1-23"
    },
    {
      "id": "libretto",
      "zh": "脚本",
      "latin": "libretto",
      "short": "歌剧的文字本。其结构（场次、唱段分布）直接决定音乐的形式安排。",
      "link": "m1-23"
    },
    {
      "id": "sonata-form",
      "zh": "奏鸣曲式",
      "latin": "sonata form",
      "short": "古典时期形成的大型结构：呈示部（主题群与调性对比）—展开部（材料拆解与转调）—再现部（调性统一）。",
      "link": "m1-32"
    },
    {
      "id": "exposition",
      "zh": "呈示部",
      "latin": "exposition",
      "short": "奏鸣曲式的第一部分：主部主题在本调、副部主题在属调（或关系调），两者形成调性与性格的双重对比。",
      "link": "m1-32"
    },
    {
      "id": "development",
      "zh": "展开部",
      "latin": "development",
      "short": "奏鸣曲式的中间段：把呈示部的动机拆解、模进、转调，制造不稳定感与戏剧张力。",
      "link": "m1-32"
    },
    {
      "id": "recapitulation",
      "zh": "再现部",
      "latin": "recapitulation",
      "short": "奏鸣曲式的第三部分：主部与副部回到主调，解决呈示部留下的调性矛盾——这是该曲式的核心逻辑。",
      "link": "m1-32"
    },
    {
      "id": "coda",
      "zh": "尾声",
      "latin": "coda",
      "short": "结构末尾的补充段落，用于收束张力。贝多芬常把尾声扩展为「第二展开部」。",
      "link": "m1-32"
    },
    {
      "id": "symphony",
      "zh": "交响曲",
      "latin": "symphony",
      "short": "为管弦乐队创作的多乐章大型作品，18 世纪中叶由意大利序曲与曼海姆乐派的乐队写法逐步定型为四乐章体制。",
      "link": "m1-32"
    },
    {
      "id": "string-quartet",
      "zh": "弦乐四重奏",
      "latin": "string quartet",
      "short": "两小提琴、中提琴、大提琴各一声部。四件同族乐器使声部既平等又清晰，成为「室内乐理想」的代表体裁。",
      "link": "m1-32"
    },
    {
      "id": "concertino",
      "zh": "协奏曲",
      "latin": "concerto",
      "short": "独奏（或小组）与乐队的对话体裁。巴洛克的大协奏曲以「小合奏 vs 全奏」对比为核心，古典时期转向独奏炫技与结构平衡。",
      "link": "m1-32"
    },
    {
      "id": "lied",
      "zh": "艺术歌曲",
      "latin": "Lied",
      "short": "诗与音乐的紧密结合：人声与钢琴共同承担表达，钢琴不只是伴奏，而参与叙事与心理描写。",
      "link": "m1-36"
    },
    {
      "id": "strophic",
      "zh": "分节歌",
      "latin": "strophic",
      "short": "同一段旋律反复配多段歌词的歌曲形式。结构经济，但需要旋律本身足够容纳不同情绪。",
      "link": "m1-36"
    },
    {
      "id": "through-composed",
      "zh": "通谱体",
      "latin": "durchkomponiert",
      "short": "每一段歌词都配以新音乐的歌曲写法，随诗歌情节连续展开，适合叙事性长诗。",
      "link": "m1-36"
    },
    {
      "id": "character-piece",
      "zh": "特性小品",
      "latin": "character piece",
      "short": "19 世纪钢琴小品的通称：以简短形式捕捉一种情绪、场景或意象，如夜曲、即兴曲、无词歌。",
      "link": "m1-36"
    },
    {
      "id": "rubato",
      "zh": "弹性速度",
      "latin": "tempo rubato",
      "short": "在不改变整体节拍的前提下局部加快或放慢，使旋律获得呼吸感。肖邦对此的运用被视为典范。",
      "link": "m1-36"
    },
    {
      "id": "liyue",
      "zh": "礼乐",
      "latin": "",
      "short": "西周制度：以「礼」区分等级、以「乐」调和情感，二者配合使用。乐器的种类、数量与舞佾人数依爵位而定。",
      "link": "m2-03"
    },
    {
      "id": "yayue",
      "zh": "雅乐",
      "latin": "",
      "short": "与俗乐相对的正统仪式音乐，用于祭祀、朝会、宴享。中国历代均有制作，但曲目多已失传。",
      "link": "m2-03"
    },
    {
      "id": "suyue",
      "zh": "俗乐",
      "latin": "",
      "short": "相对于雅乐的民间与流行音乐，包括郑卫之音、曲子、戏曲等。历代宫廷既排斥又不断吸收它。",
      "link": "m2-04"
    },
    {
      "id": "yiwu",
      "zh": "舞佾",
      "latin": "",
      "short": "西周礼制中按等级规定的乐舞行列人数。天子八佾（八行八列），诸侯六佾，以下递减，是「乐与政通」的具体化。",
      "link": "m2-03"
    },
    {
      "id": "biandiao",
      "zh": "编钟",
      "latin": "",
      "short": "青铜铸造的成套打击乐器，按大小与音高排列悬挂。曾侯乙编钟证明先秦已掌握一钟双音的铸造技术。",
      "link": "m2-05"
    },
    {
      "id": "yizhong-shuangyin",
      "zh": "一钟双音",
      "latin": "",
      "short": "同一钟体的正鼓部与侧鼓部可发出相隔三度的两个音，先秦铸钟的关键技术，为演奏旋律提供条件。",
      "link": "m2-05"
    },
    {
      "id": "bayin",
      "zh": "八音",
      "latin": "",
      "short": "按材质分类的乐器体系：金、石、丝、竹、匏、土、革、木。它是中国最早的乐器分类法，也是礼制秩序的象征。",
      "link": "m2-05"
    },
    {
      "id": "sanjian-sunyi",
      "zh": "三分损益法",
      "latin": "",
      "short": "以弦长或管长按 2:3 与 4:3 的比例交替增减来生成音律的方法，与西方五度相生律同源，但计算起点与顺序不同。",
      "link": "m2-06"
    },
    {
      "id": "xuangong",
      "zh": "旋宫",
      "latin": "",
      "short": "以十二律中任一音为宫音建立调式的能力。能否自由旋宫，是衡量古代律制实用性的核心指标。",
      "link": "m2-25"
    },
    {
      "id": "yuefu",
      "zh": "乐府",
      "latin": "",
      "short": "秦汉至唐代的宫廷音乐机构，职能包括采集民间歌谣、创作与排练宫廷乐舞、管理乐工。汉武帝时大规模扩建。",
      "link": "m2-08"
    },
    {
      "id": "guchui",
      "zh": "鼓吹乐",
      "latin": "",
      "short": "以鼓、角、笳、笛为主的器乐合奏，源自北方游牧民族，汉代进入宫廷，按用途分为黄门鼓吹、骑吹、短箫铙歌等。",
      "link": "m2-10"
    },
    {
      "id": "xianghe",
      "zh": "相和歌",
      "latin": "",
      "short": "汉代俗乐形式：由无伴奏的「徒歌」、加入帮腔的「但歌」，发展为丝竹伴奏的「相和歌」，再扩展为多段落的相和大曲。",
      "link": "m2-09"
    },
    {
      "id": "qingshang",
      "zh": "清商乐",
      "latin": "",
      "short": "魏晋南北朝时期以南方吴歌、西曲与北方相和歌汇合而成的俗乐体系，是隋唐燕乐的重要来源。",
      "link": "m2-14"
    },
    {
      "id": "yanyue",
      "zh": "燕乐",
      "latin": "",
      "short": "古代宫廷宴享所用音乐的总称。唐代燕乐融合胡部与俗乐，形成多部乐与坐、立部伎的庞大体制。",
      "link": "m2-19"
    },
    {
      "id": "duobuyue",
      "zh": "多部乐",
      "latin": "",
      "short": "隋唐宫廷按地区与来源分部的乐舞体制：七部乐、九部乐、十部乐。它同时是政治地图的音乐版本。",
      "link": "m2-19"
    },
    {
      "id": "zuolibuji",
      "zh": "坐部伎 / 立部伎",
      "latin": "",
      "short": "唐代宫廷燕乐的两大类别：坐部伎在堂上坐着演奏，人数少、技艺精；立部伎在堂下站立，人数多、声势大。",
      "link": "m2-20"
    },
    {
      "id": "daqu",
      "zh": "大曲",
      "latin": "",
      "short": "结构庞大的歌舞套曲，通常由「散序—中序—入破」三部分组成，是唐代燕乐的最高形式。",
      "link": "m2-20"
    },
    {
      "id": "jiaofang",
      "zh": "教坊",
      "latin": "",
      "short": "唐代管理俗乐歌舞的宫廷机构，负责教习、排练与演出，与专习法曲的「梨园」分工。",
      "link": "m2-22"
    },
    {
      "id": "quzi",
      "zh": "曲子",
      "latin": "",
      "short": "隋唐时期配合特定曲调填词歌唱的短小歌曲，是民歌与文人创作之间的桥梁，也是「词」的音乐来源。",
      "link": "m2-23"
    },
    {
      "id": "bianwen",
      "zh": "变文",
      "latin": "",
      "short": "唐代寺院中以说唱方式讲述佛经故事或世俗故事的体裁，散文与韵文交替，是后世说唱音乐的早期形态。",
      "link": "m2-24"
    },
    {
      "id": "ershibadiao",
      "zh": "燕乐二十八调",
      "latin": "",
      "short": "唐代形成的宫调体系：七宫 × 四调。其实际结构与调名含义在学界仍有争论，是乐律史上的难点。",
      "link": "m2-25"
    },
    {
      "id": "gongche",
      "zh": "工尺谱",
      "latin": "",
      "short": "以「上尺工凡六五乙」等字记录音高的传统记谱法，明清以来广泛用于戏曲、器乐与曲艺。",
      "link": "m2-25"
    },
    {
      "id": "washe",
      "zh": "瓦舍勾栏",
      "latin": "",
      "short": "宋代城市的固定娱乐场所。「瓦舍」是综合游乐区，「勾栏」是其中用栏杆围起的单个演出棚。",
      "link": "m2-27"
    },
    {
      "id": "cipai",
      "zh": "词牌",
      "latin": "",
      "short": "填词所依据的曲调名称，规定字数、句读与平仄。同一词牌可有多体，音乐却大多失传。",
      "link": "m2-28"
    },
    {
      "id": "panggong",
